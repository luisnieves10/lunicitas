# LuniCitas
Options -Indexes
DirectoryIndex inicio.php index.html

# Archivos que nunca se deben ver desde el navegador
<FilesMatch "^(config\.php|config-claves\.php|lib\.php|recordatorios\.php|\.git.*|README\.md)$">
  Require all denied
</FilesMatch>

# App instalable
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# El logo y los iconos se revisan siempre, para que el navegador no muestre uno viejo
<IfModule mod_headers.c>
  <FilesMatch "\.(svg|ico)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Enlace de cada negocio: lunicitas.com/mi-barberia
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^\.git - [F,L]
# Direcciones cortas
RewriteRule ^entrar/?$ admin.php [L,QSA]
RewriteRule ^registro/?$ registro.php [L,QSA]
RewriteRule ^contacto/?$ contacto.php [L,QSA]
RewriteRule ^recuperar/?$ recuperar.php [L,QSA]
RewriteRule ^(terminos|terms)/?$ legal.php?p=terminos [L]
RewriteRule ^(privacidad|privacy)/?$ legal.php?p=privacidad [L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]{3,40})/$ $1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([a-z0-9-]{3,40})$ index.html [L]
</IfModule>
